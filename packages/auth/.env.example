# @an/auth environment variables.
# In real environments, all of these come from cloud secrets management.

# JWT signing secret. ≥ 32 random bytes, base64 or hex.
# Generate locally with: openssl rand -hex 64
JWT_SECRET=replace_me_with_at_least_64_random_hex_characters_for_local_dev_use_only

# JWT issuer claim (informational).
JWT_ISSUER=an-central-command

# Redis connection (mirrors infra/docker-compose.yml).
REDIS_URL=redis://localhost:6379

# Shared with @an/db. Required because login() looks up people + auth_credentials.
DATABASE_URL=postgres://alfayo:localdev_only_not_production@localhost:5433/alfayo_dev

# pgcrypto key (will be used to decrypt totp_secret once column-encryption migration lands).
PGCRYPTO_KEY=local_dev_key_change_me_in_every_real_environment
