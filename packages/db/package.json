{
  "name": "@an/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "description": "Drizzle schema, migrations, and seed scripts for the platform Postgres+PostGIS database. 19 entities per ARC §6 ERD. PostGIS geometry, pgcrypto column encryption, RLS policies, append-only audit_log trigger.",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:apply-extras": "tsx src/apply-extras.ts",
    "db:migrate:all": "pnpm db:migrate && pnpm db:apply-extras",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts",
    "lint": "node -e \"console.log('placeholder')\"",
    "type-check": "tsc --noEmit",
    "test": "node -e \"console.log('placeholder')\""
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
