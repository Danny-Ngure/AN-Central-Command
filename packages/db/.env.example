# Database connection string for local development.
# Matches the credentials in infra/docker-compose.yml. Do NOT use in any other environment.
# Production reads DATABASE_URL from AWS Secrets Manager (SRS §6.2).
DATABASE_URL=postgres://alfayo:localdev_only_not_production@localhost:5433/alfayo_dev

# pgcrypto column-encryption key (SRS NFR-012). Local-only value.
# Production: managed by cloud KMS; rotated periodically.
PGCRYPTO_KEY=local_dev_key_change_me_in_every_real_environment
