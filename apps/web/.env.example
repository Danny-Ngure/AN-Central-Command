# apps/web/.env.local — local development.
# Production gets these from AWS Secrets Manager (SRS §6.2).

# Database (matches packages/db/.env.example).
DATABASE_URL=postgres://alfayo:localdev_only_not_production@localhost:5433/alfayo_dev

# Auth.
JWT_SECRET=replace_me_with_at_least_64_random_hex_characters_for_local_dev_use_only
JWT_ISSUER=an-central-command

# Redis (matches infra/docker-compose.yml).
REDIS_URL=redis://localhost:6379

# pgcrypto key — required to decrypt totp_secret once column-encryption migration lands.
PGCRYPTO_KEY=local_dev_key_change_me_in_every_real_environment

# Mapbox GL JS access token (client-side — must be NEXT_PUBLIC_*).
# Get one at https://account.mapbox.com/access-tokens/ — a default public token works for dev.
# In production, restrict by URL referrer in the Mapbox dashboard.
# If left blank the dashboard map falls back to its SVG renderer.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Election date for the countdown widget (SRS FR-090). ISO 8601.
# Default if unset: 2027-08-09T03:00:00Z (06:00 East Africa Time, polls open).
# Administrators change this if the IEBC moves election day.
NEXT_PUBLIC_ELECTION_DATE=2027-08-09T03:00:00Z

