# Expo environment vars — only NEXT_PUBLIC_-style EXPO_PUBLIC_* vars are exposed
# to the JS bundle. Anything else stays on the dev / build server.

# Base URL of the @an/web API.
# Dev defaults per platform:
#   iOS Simulator:        http://localhost:3000
#   Android Emulator:     http://10.0.2.2:3000    (special alias for host)
#   Physical device:      http://<your-host-LAN-ip>:3000
# Production: the deployed @an/web URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
