{
  "expo": {
    "name": "AN Field",
    "slug": "an-field",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "anfield",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alfayonelson.field"
    },
    "android": {
      "package": "com.alfayonelson.field",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AN Central Command uses your location to tag field visits with the village you are in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5d79f1d6-9e5c-4a09-90d4-c929b8ec9107"
      }
    },
    "owner": "kimaniimmanuel",
    "updates": {
      "url": "https://u.expo.dev/5d79f1d6-9e5c-4a09-90d4-c929b8ec9107"
    }
  }
}
